# ==============================================================================
# LayarRika 🎬 — Environment Variables Template (Production & Development)
# Salin file ini menjadi .env.local untuk penggunaan lokal.
# Pasang variabel-variabel di bawah ini pada Dashboard Vercel (Project Settings -> Environment Variables).
# PERINGATAN: JANGAN PERNAH menyimpan kredensial asli/rahasia ke dalam git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Neon Serverless PostgreSQL & Prisma ORM
# Dapatkan connection strings dari Console Neon (https://console.neon.tech)
# ------------------------------------------------------------------------------
# DATABASE_URL (Pooled Endpoint): Digunakan oleh aplikasi serverless Next.js di Vercel.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL (Direct Endpoint): Wajib diisi untuk Prisma CLI saat migrasi (npx prisma migrate deploy).
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Auth.js (NextAuth.js v5) & Session Security
# ------------------------------------------------------------------------------
# AUTH_SECRET: Generate string acak aman menggunakan: openssl rand -base64 32
AUTH_SECRET="your_cryptographic_random_auth_secret_here"

# NEXTAUTH_URL: URL dasar aplikasi web.
# Di lingkungan lokal: http://localhost:3000
# Di lingkungan Vercel: https://layarrika.vercel.app (atau domain custom Anda)
NEXTAUTH_URL="https://layarrika.vercel.app"

# NEXT_PUBLIC_APP_URL: Digunakan untuk sitemap.xml, robots.txt, metadata SEO & OpenGraph.
NEXT_PUBLIC_APP_URL="https://layarrika.vercel.app"

# ------------------------------------------------------------------------------
# 3. GitHub OAuth 2.0 Credentials (Autentikasi Pengguna)
# Dapatkan dari GitHub Developer Settings -> OAuth Apps (https://github.com/settings/developers)
# Callback URL Production: https://<domain-vercel-anda>.vercel.app/api/auth/callback/github
# Callback URL Lokal: http://localhost:3000/api/auth/callback/github
# ------------------------------------------------------------------------------
AUTH_GITHUB_ID="your_github_oauth_client_id"
AUTH_GITHUB_SECRET="your_github_oauth_client_secret"

# ------------------------------------------------------------------------------
# 4. TMDB API (The Movie Database) — Metadata Katalog Sinematik
# Dapatkan token akses gratis di: https://www.themoviedb.org/settings/api
# Gunakan "API Read Access Token" (Bearer Token panjang), bukan API Key pendek.
# PERINGATAN: JANGAN gunakan prefix NEXT_PUBLIC_ untuk token rahasia ini!
# ------------------------------------------------------------------------------
TMDB_API_READ_ACCESS_TOKEN="your_tmdb_v4_read_access_token_here"
TMDB_API_KEY="your_tmdb_v3_api_key_here"

# ------------------------------------------------------------------------------
# 5. Midtrans Payment Gateway (Virtual Account BCA, BNI, BRI & Snap Checkout)
# Dapatkan Server Key & Client Key dari:
# Sandbox: https://dashboard.sandbox.midtrans.com/ (Menu: Settings -> Access Keys)
# Production: https://dashboard.midtrans.com/
# ------------------------------------------------------------------------------
# Server Key (Privat, server-side only)
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_MIDTRANS_SERVER_KEY"

# Client Key (Publik, frontend Snap dialog)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_MIDTRANS_CLIENT_KEY"

# Mode Midtrans: "false" untuk Sandbox, "true" untuk Live Production
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 6. Mode Simulasi Pembayaran (Development & Demo Kampus)
# Di lingkungan PRODUCTION Vercel: Wajib bernilai "false"
# Di lingkungan LOKAL tanpa koneksi Midtrans: Boleh "true"
# ------------------------------------------------------------------------------
ENABLE_SIMULATED_PAYMENTS="false"
SIMULATED_BILLING_ENABLED="false"

# ------------------------------------------------------------------------------
# 7. Streaming Provider Whitelist (Opsional)
# Domain CDN video berlisensi tambahan yang diizinkan (dipisahkan koma)
# ------------------------------------------------------------------------------
LICENSED_STREAM_HOSTS="commondatastorage.googleapis.com,test-streams.mux.dev"
