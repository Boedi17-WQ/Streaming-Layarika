# ==============================================================================
# LayarRika — Environment Variables Template
# Salin file ini menjadi .env.local untuk penggunaan pengembangan lokal.
# JANGAN PERNAH menyimpan kredensial asli atau rahasia ke dalam repositori git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TMDB API (The Movie Database) — Digunakan pada Tahap 2
# Dapatkan token akses gratis di: https://www.themoviedb.org/settings/api
# Gunakan "API Read Access Token" (Bearer Token panjang), bukan API Key pendek.
# PERINGATAN: JANGAN gunakan prefix NEXT_PUBLIC_ untuk token rahasia ini!
TMDB_API_READ_ACCESS_TOKEN="your_tmdb_read_access_token_here"
TMDB_API_KEY="your_tmdb_api_key_here"

# ------------------------------------------------------------------------------
# 2. Database Neon PostgreSQL & Prisma ORM — Digunakan pada Tahap 3
# Buat database serverless gratis di: https://neon.tech
# Pooled URL digunakan untuk query aplikasi serverless.
# Direct URL digunakan untuk Prisma migration cli.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Auth.js (NextAuth.js v5) — Digunakan pada Tahap 4
# Generate secret dengan: openssl rand -base64 32
# ------------------------------------------------------------------------------
AUTH_SECRET="your_generated_random_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Mode Sistem Pembayaran Simulasi — Digunakan pada Tahap 7 & 9
# bernilai "true" hanya untuk development atau demo perkuliahan.
# Pada environment production Vercel, flag ini HARUS diset ke "false".
# ------------------------------------------------------------------------------
ENABLE_SIMULATED_PAYMENTS="true"
SIMULATED_BILLING_ENABLED="true"

# ------------------------------------------------------------------------------
# 5. Midtrans Payment Gateway (Sandbox Mode)
# Dapatkan Server Key & Client Key dari Dashboard Midtrans: https://dashboard.sandbox.midtrans.com/
# Menu: Settings -> Access Keys
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SERVER_KEY_HERE"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY_HERE"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

